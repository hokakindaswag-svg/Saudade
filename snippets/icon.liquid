  {%- when 'chevron-right' -%}
    <svg viewBox="0 0 8 12" fill="none" aria-hidden="true" focusable="false"><path d="M1.5 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 20 12" fill="none" aria-hidden="true" focusable="false"><path d="M0 6h18M13 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'filter' -%}
