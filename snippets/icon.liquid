{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', icon: 'cart' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="6.2" stroke="currentColor" stroke-width="1.3"/><path d="M13.6 13.6L18 18" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><circle cx="10" cy="6.6" r="3.4" stroke="currentColor" stroke-width="1.3"/><path d="M3.4 17.4c0-3.4 2.9-5.6 6.6-5.6s6.6 2.2 6.6 5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M3.2 5.8h13.6l-1.1 11.4a1 1 0 0 1-1 .9H5.3a1 1 0 0 1-1-.9L3.2 5.8Z" stroke="currentColor" stroke-width="1.3"/><path d="M7.1 8V5.2a2.9 2.9 0 0 1 5.8 0V8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
