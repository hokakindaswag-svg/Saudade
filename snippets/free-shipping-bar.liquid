{%- if settings.cart_free_shipping_bar and settings.cart_free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.cart_free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
    assign remaining_money = remaining | money
  -%}
  <div class="ship-bar{% if remaining <= 0 %} ship-bar--complete{% endif %}">
    <p class="ship-bar__text">
      {%- if remaining > 0 -%}
        {{ 'sections.cart.free_shipping_progress' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'sections.cart.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track"><div class="ship-bar__fill" style="width: {{ pct }}%"></div></div>
  </div>
{%- endif -%}
