<div class="account account__form">
  <h1 class="h1 text-center" style="margin-bottom: 12px;">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="text-muted text-center" style="margin-bottom: 20px;">{{ 'customer.reset_password.subtext' | t }}</p>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label class="field__label" for="ResetPw">{{ 'customer.reset_password.password' | t }}</label><input class="input" type="password" id="ResetPw" name="customer[password]" autocomplete="new-password"></div>
    <div class="field"><label class="field__label" for="ResetPwConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label><input class="input" type="password" id="ResetPwConfirm" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <button type="submit" class="btn btn--primary btn--full btn--lg">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>
