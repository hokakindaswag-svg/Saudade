<div class="account">
  <h1 class="h1" style="margin-bottom: 24px;">{{ 'customer.addresses.title' | t }}</h1>

  <button type="button" class="btn btn--outline" onclick="var e=document.getElementById('NewAddress'); e.hidden=!e.hidden;">
    {{ 'customer.addresses.add_new' | t }}
  </button>

  <div id="NewAddress" hidden style="margin-top: 22px; max-width: 480px;">
    {%- form 'customer_address', customer.new_address -%}
      {{ form.errors | default_errors }}
      <div class="field"><label class="field__label" for="AddrFirst">{{ 'customer.addresses.first_name' | t }}</label><input class="input" id="AddrFirst" type="text" name="address[first_name]" autocomplete="given-name"></div>
      <div class="field"><label class="field__label" for="AddrLast">{{ 'customer.addresses.last_name' | t }}</label><input class="input" id="AddrLast" type="text" name="address[last_name]" autocomplete="family-name"></div>
      <div class="field"><label class="field__label" for="AddrCompany">{{ 'customer.addresses.company' | t }}</label><input class="input" id="AddrCompany" type="text" name="address[company]" autocomplete="organization"></div>
      <div class="field"><label class="field__label" for="Addr1">{{ 'customer.addresses.address1' | t }}</label><input class="input" id="Addr1" type="text" name="address[address1]" autocomplete="address-line1"></div>
      <div class="field"><label class="field__label" for="Addr2">{{ 'customer.addresses.address2' | t }}</label><input class="input" id="Addr2" type="text" name="address[address2]" autocomplete="address-line2"></div>
      <div class="field"><label class="field__label" for="AddrCity">{{ 'customer.addresses.city' | t }}</label><input class="input" id="AddrCity" type="text" name="address[city]" autocomplete="address-level2"></div>
      <div class="field"><label class="field__label" for="AddrCountry">{{ 'customer.addresses.country' | t }}</label>
        <select class="input" id="AddrCountry" name="address[country]" data-default="{{ form.country }}">{{ country_option_tags }}</select>
      </div>
      <div class="field"><label class="field__label" for="AddrZip">{{ 'customer.addresses.zip' | t }}</label><input class="input" id="AddrZip" type="text" name="address[zip]" autocomplete="postal-code"></div>
      <div class="field"><label class="field__label" for="AddrPhone">{{ 'customer.addresses.phone' | t }}</label><input class="input" id="AddrPhone" type="tel" name="address[phone]" autocomplete="tel"></div>
      <label class="facet__option"><input type="checkbox" name="address[default]" value="1"> <span>{{ 'customer.addresses.set_default' | t }}</span></label>
      <button type="submit" class="btn btn--primary btn--full" style="margin-top: 12px;">{{ 'customer.addresses.add' | t }}</button>
    {%- endform -%}
  </div>

  <div style="display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 34px;">
    {%- for address in customer.addresses -%}
      <div style="border: 1px solid var(--color-line); padding: 18px;">
        {%- if address == customer.default_address -%}<p class="ui-label text-muted" style="margin-bottom: 8px;">Default</p>{%- endif -%}
        {{ address | format_address }}
        <p style="margin-top: 12px; display: flex; gap: 14px;">
          <a class="link-underline" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.edit' | t }}</a>
          <a class="link-underline" href="{{ address.url }}" data-method="delete"
             onclick="return confirm('{{ 'customer.addresses.delete_confirm' | t }}');">{{ 'customer.addresses.delete' | t }}</a>
        </p>
      </div>
    {%- endfor -%}
  </div>

  <p style="margin-top: 30px;"><a class="link-underline" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a></p>
</div>
