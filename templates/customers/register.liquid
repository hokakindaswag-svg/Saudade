<div class="account account__form">
  <h1 class="h1 text-center" style="margin-bottom: 24px;">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label class="field__label" for="RegFirst">{{ 'customer.register.first_name' | t }}</label>
      <input class="input" type="text" id="RegFirst" name="customer[first_name]" autocomplete="given-name">
    </div>
    <div class="field">
      <label class="field__label" for="RegLast">{{ 'customer.register.last_name' | t }}</label>
      <input class="input" type="text" id="RegLast" name="customer[last_name]" autocomplete="family-name">
    </div>
    <div class="field">
      <label class="field__label" for="RegEmail">{{ 'customer.register.email' | t }}</label>
      <input class="input" type="email" id="RegEmail" name="customer[email]" autocomplete="email" required>
    </div>
    <div class="field">
      <label class="field__label" for="RegPassword">{{ 'customer.register.password' | t }}</label>
      <input class="input" type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top: 12px;">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
  <p class="text-center" style="margin-top: 26px;">
    <a class="link-underline" href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a>
  </p>
</div>
