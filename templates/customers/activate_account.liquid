<div class="account account__form">
  <h1 class="h1 text-center" style="margin-bottom: 12px;">{{ 'customer.activate_account.title' | t }}</h1>
  <p class="text-muted text-center" style="margin-bottom: 20px;">{{ 'customer.activate_account.subtext' | t }}</p>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label class="field__label" for="ActivatePw">{{ 'customer.activate_account.password' | t }}</label><input class="input" type="password" id="ActivatePw" name="customer[password]" autocomplete="new-password"></div>
    <div class="field"><label class="field__label" for="ActivatePwConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label><input class="input" type="password" id="ActivatePwConfirm" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <button type="submit" class="btn btn--primary btn--full btn--lg">{{ 'customer.activate_account.submit' | t }}</button>
    <button type="submit" name="decline" class="btn btn--outline btn--full" style="margin-top: 10px;">{{ 'customer.activate_account.cancel' | t }}</button>
  {%- endform -%}
</div>
