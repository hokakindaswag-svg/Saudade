<div class="account">
  <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 26px;">
    <h1 class="h1">{{ 'customer.account.title' | t }}</h1>
    <a class="link-underline ui-label" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
  </div>

  <h2 class="section-title" style="margin-bottom: 14px;">{{ 'customer.account.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <div style="overflow-x: auto;">
        <table class="table">
          <thead>
            <tr>
              <th>{{ 'customer.orders.order_number' | t }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.payment_status' | t }}</th>
              <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
              <th>{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr>
                <td><a class="link-underline" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: '%d %b %Y' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="text-muted">{{ 'customer.account.no_orders' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}

  <h2 class="section-title" style="margin: 40px 0 14px;">{{ 'customer.account.details' | t }}</h2>
  {{ customer.default_address | format_address }}
  <p><a class="link-underline" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})</a></p>
</div>
