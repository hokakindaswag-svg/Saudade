<div class="section" style="background: {{ section.settings.bg }}; color: {{ section.settings.text_color }};">
  <div class="page-width">
    <div class="newsletter" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="ui-label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1" style="margin-top: 10px;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="newsletter__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter_form.email_placeholder' | t }}</label>
        <input class="input" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required
               placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" autocomplete="email">
        <button type="submit" class="btn btn--primary">{{ section.settings.button_label }}</button>
      {%- if form.errors -%}
        <p class="form-status form-status--error">{{ form.errors.messages['email'] }}</p>
      {%- elsif form.posted_successfully? -%}
        <p class="form-status form-status--success">{{ 'general.newsletter_form.success' | t }}</p>
      {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="text-muted" style="font-size: 1.1rem; margin-top: 12px;">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "class": "shopify-section--newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "GET IN EARLY" },
    { "type": "text", "id": "text", "label": "Text", "default": "First access to drops, restocks & everything Saudade." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SIGN UP" },
    { "type": "text", "id": "disclaimer", "label": "Small print", "default": "No spam. Unsubscribe any time." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F1EBE6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141110" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
