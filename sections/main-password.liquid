<div class="page-width section text-center" style="min-height: 70vh; display: grid; place-content: center; gap: 20px;">
  {%- if settings.logo != blank -%}
    <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" style="width: 220px; margin: 0 auto;">
  {%- else -%}
    <p class="h-display">{{ shop.name }}</p>
  {%- endif -%}
  <p class="h2">{{ section.settings.heading }}</p>
  <p class="text-muted">{{ section.settings.text }}</p>
  {%- form 'customer', class: 'newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="visually-hidden" for="PasswordEmail">Email</label>
    <input class="input" id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required>
    <button type="submit" class="btn btn--primary">{{ 'general.newsletter_form.submit' | t }}</button>
  {%- endform -%}
  <div>
    <button type="button" class="link-underline ui-label" onclick="document.getElementById('PasswordLogin').hidden = false; this.hidden = true;">Enter using password</button>
    <div id="PasswordLogin" hidden style="margin-top: 16px;">
      {%- form 'storefront_password', class: 'newsletter__form' -%}
        <label class="visually-hidden" for="StorefrontPassword">Password</label>
        <input class="input" id="StorefrontPassword" type="password" name="password" placeholder="Password">
        <button type="submit" class="btn btn--primary">Enter</button>
        {%- if form.errors -%}<p class="form-status form-status--error">{{ form.errors.messages['form'] }}</p>{%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something is coming." },
    { "type": "text", "id": "text", "label": "Text", "default": "Sign up to be first through the door." }
  ]
}
{% endschema %}
