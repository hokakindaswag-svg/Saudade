{%- liquid
  assign coll = section.settings.collection
  assign products_to_show = section.settings.count
-%}

<div class="section{% if section.settings.tight %} section--tight{% endif %}">
  <div class="{% if section.settings.full_width %}page-width page-width--full{% else %}page-width{% endif %}"
       {% if section.settings.full_width %}style="padding-inline: var(--gutter);"{% endif %}>

    {%- if section.settings.heading != blank or section.settings.link_text != blank -%}
      <div class="section-head" data-reveal>
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.link_text != blank -%}
          <a class="section-head__link" href="{{ section.settings.link_url | default: coll.url }}">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if coll.products.size > 0 -%}
      {%- if section.settings.layout == 'scroll' -%}
        <div class="scroller" style="--item-w: 66%; --item-w-tablet: 34%; --item-w-desktop: {% if section.settings.columns == 3 %}31%{% elsif section.settings.columns == 5 %}19%{% else %}23.5%{% endif %};">
          {%- for product in coll.products limit: products_to_show -%}
            {% render 'product-card', product: product, index: forloop.index, sizes_attr: '(min-width: 990px) 25vw, 66vw' %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="product-grid" style="--cols: {{ section.settings.columns }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-mobile: {{ section.settings.columns_mobile }};">
          {%- for product in coll.products limit: products_to_show -%}
            {% render 'product-card', product: product, index: forloop.index %}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_bottom_cta and coll != blank -%}
        <div class="text-center" style="margin-top: 34px;">
          <a class="btn btn--outline btn--lg" href="{{ coll.url }}">{{ section.settings.bottom_cta_text }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="product-grid" style="--cols: {{ section.settings.columns }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-mobile: {{ section.settings.columns_mobile }};">
        {%- for i in (1..section.settings.columns) -%}
          <div class="card">
            <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__info">
              <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="card__price">{{ 4900 | money }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product grid",
  "class": "shopify-section--products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "NEW IN" },
    { "type": "text", "id": "link_text", "label": "Link label", "default": "VIEW ALL" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "min": 2, "max": 24, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [
      { "value": "grid", "label": "Grid" },
      { "value": "scroll", "label": "Horizontal scroll" }
    ]},
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "range", "id": "columns_tablet", "min": 2, "max": 4, "step": 1, "label": "Columns (tablet)", "default": 3 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 2, "step": 1, "label": "Columns (mobile)", "default": 2 },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "checkbox", "id": "tight", "label": "Reduce vertical spacing", "default": false },
    { "type": "checkbox", "id": "show_bottom_cta", "label": "Show button below", "default": false },
    { "type": "text", "id": "bottom_cta_text", "label": "Button label", "default": "SHOP ALL" }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
