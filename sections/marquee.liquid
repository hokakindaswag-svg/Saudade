<div class="marquee" style="background: {{ section.settings.bg }}; color: {{ section.settings.text_color }}; border-color: {{ section.settings.bg }};">
  <div class="marquee__inner" style="animation-duration: {{ section.settings.speed }}s;">
    {%- for i in (1..2) -%}
      <div class="marquee__item" aria-hidden="{% if forloop.index > 1 %}true{% else %}false{% endif %}">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          <span>&bull;</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text",
  "class": "shopify-section--marquee",
  "max_blocks": 8,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FF2E88" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 5, "unit": "s", "label": "Scroll duration", "default": 30 }
  ],
  "blocks": [
    { "type": "item", "name": "Text", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "SAUDADE" }] }
  ],
  "presets": [
    { "name": "Scrolling text", "blocks": [
      { "type": "item", "settings": { "text": "NEW DROP" } },
      { "type": "item", "settings": { "text": "SAUDADE" } },
      { "type": "item", "settings": { "text": "LIMITED RUN" } }
    ]}
  ]
}
{% endschema %}
