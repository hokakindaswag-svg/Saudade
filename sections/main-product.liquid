{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign color_name = settings.swatch_option_name | downcase
-%}

<div class="product" data-product-root data-reveal>

  {%- comment -%} ---------- MEDIA ---------- {%- endcomment -%}
  <div class="product__media-wrap">
    <div class="product__media{% if section.settings.desktop_layout == 'grid' %} product__media--grid{% endif %}" data-product-media>
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          <div class="product__media-item" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <img src="{{ media | image_url: width: 1400 }}"
                     srcset="{{ media | image_url: width: 500 }} 500w, {{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                     sizes="(min-width: 990px) 55vw, 100vw"
                     alt="{{ media.alt | default: product.title | escape }}"
                     width="{{ media.width }}" height="{{ media.height }}"
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     {% if forloop.first %}fetchpriority="high"{% endif %}>
              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1200x', controls: true, muted: true, loop: true, playsinline: true }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="product__media-item">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="product__media-dots">
        {%- for media in product.media -%}
          <span class="product__media-dot{% if forloop.first %} is-active{% endif %}" data-media-dot></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- INFO ---------- {%- endcomment -%}
  <div class="product__info-wrap">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'vendor' -%}
          {%- if product.vendor != blank -%}
            <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
          {%- endif -%}

        {%- when 'title' -%}
          <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

        {%- when 'price' -%}
          <div {{ block.shopify_attributes }}>
            <div class="product__price price" data-product-price>
              <span class="price__current">{{ current_variant.price | money }}</span>
              {%- if current_variant.compare_at_price > current_variant.price -%}
                <s class="price__compare">{{ current_variant.compare_at_price | money }}</s>
              {%- endif -%}
            </div>
            {%- if block.settings.tax_note != blank -%}
              <p class="product__tax-note">{{ block.settings.tax_note }}</p>
            {%- endif -%}
            {%- form 'product', product, id: 'InstallmentForm' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
              {{ form | payment_terms }}
            {%- endform -%}
          </div>

        {%- when 'variant_picker' -%}
          {%- unless product.has_only_default_variant -%}
            <div {{ block.shopify_attributes }}>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign opt_lower = option.name | downcase
                  assign is_color = false
                  if opt_lower == color_name
                    assign is_color = true
                  endif
                -%}
                <div class="option">
                  <div class="option__head">
                    <span class="option__name">
                      {{ option.name }}: <span class="option__value" data-option-selected="{{ forloop.index }}">{{ option.selected_value }}</span>
                    </span>
                    {%- if block.settings.size_guide_page != blank and is_color == false -%}
                      <button type="button" class="option__link" data-open="SizeGuide">
                        {{ 'products.product.size_guide' | t }}
                      </button>
                    {%- endif -%}
                  </div>
                  <div class="option__values">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign input_id = 'Option-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index
                        assign swatch_style = ''
                        if is_color
                          assign fallback = value | downcase | replace: ' ', ''
                          assign swatch_style = 'background-color: ' | append: fallback | append: ';'
                          if value.swatch.color
                            assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                          endif
                          if value.swatch.image
                            assign sw_url = value.swatch.image | image_url: width: 80
                            assign swatch_style = swatch_style | append: ' background-image: url(' | append: sw_url | append: ');'
                          endif
                        endif
                      -%}
                      <input type="radio" id="{{ input_id }}"
                             name="option-{{ forloop.parentloop.index }}"
                             value="{{ value | escape }}"
                             data-option-input
                             data-option-position="{{ forloop.parentloop.index }}"
                             {% if option.selected_value == value %}checked{% endif %}>
                      <label class="option__pill{% if is_color %} option__swatch{% endif %}"
                             for="{{ input_id }}"
                             {% if is_color %}style="{{ swatch_style }}" title="{{ value | escape }}"{% endif %}>
                        {%- unless is_color -%}{{ value }}{%- else -%}<span class="visually-hidden">{{ value }}</span>{%- endunless -%}
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

        {%- when 'buy_buttons' -%}
          <div {{ block.shopify_attributes }} data-atc-anchor>
            {%- form 'product', product, id: 'ProductForm', class: 'product-form', novalidate: 'novalidate', data-product-form: 'true' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
              {%- unless block.settings.show_quantity -%}
                <input type="hidden" name="quantity" value="1">
              {%- endunless -%}

              {%- if block.settings.show_quantity -%}
                <div class="option">
                  <span class="option__name">{{ 'products.product.quantity' | t }}</span>
                  <div class="qty" data-qty style="margin-top: 8px;">
                    <button type="button" data-qty-change="-1" aria-label="Decrease quantity">&minus;</button>
                    <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
                    <button type="button" data-qty-change="1" aria-label="Increase quantity">+</button>
                  </div>
                </div>
              {%- endif -%}

              <p class="product-form__error" data-form-error hidden></p>

              <button type="submit" class="btn btn--primary btn--full btn--lg" data-add-button
                      {% unless current_variant.available %}aria-disabled="true"{% endunless %}>
                <span class="btn__text">
                  {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </span>
              </button>

              {%- if block.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            {%- endform -%}

            {%- if block.settings.show_stock and current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock_threshold -%}
              <p class="product-form__error" style="color: var(--color-accent); margin-top: 8px;">
                {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
              </p>
            {%- endif -%}
          </div>

        {%- when 'trust' -%}
          <ul class="product__trust" {{ block.shopify_attributes }}>
            {%- if block.settings.item_1 != blank -%}<li>{% render 'icon', icon: 'truck' %}{{ block.settings.item_1 }}</li>{%- endif -%}
            {%- if block.settings.item_2 != blank -%}<li>{% render 'icon', icon: 'return' %}{{ block.settings.item_2 }}</li>{%- endif -%}
            {%- if block.settings.item_3 != blank -%}<li>{% render 'icon', icon: 'lock' %}{{ block.settings.item_3 }}</li>{%- endif -%}
          </ul>

        {%- when 'description' -%}
          {%- if product.description != blank -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <button type="button" class="accordion__head" aria-expanded="{{ block.settings.open }}" aria-controls="Acc-{{ block.id }}">
                <span>{{ block.settings.heading }}</span>
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__body{% if block.settings.open %} is-open{% endif %}" id="Acc-{{ block.id }}">
                <div><div class="accordion__inner rte">{{ product.description }}</div></div>
              </div>
            </div>
          {%- endif -%}

        {%- when 'accordion' -%}
          {%- liquid
            assign body = block.settings.text
            if block.settings.page != blank
              assign body = block.settings.page.content
            endif
          -%}
          {%- if body != blank -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <button type="button" class="accordion__head" aria-expanded="false" aria-controls="Acc-{{ block.id }}">
                <span>{{ block.settings.heading }}</span>
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__body" id="Acc-{{ block.id }}">
                <div><div class="accordion__inner rte">{{ body }}</div></div>
              </div>
            </div>
          {%- endif -%}

        {%- when 'metafield_accordion' -%}
          {%- assign mf = product.metafields.custom[block.settings.metafield_key] -%}
          {%- if mf != blank -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <button type="button" class="accordion__head" aria-expanded="false" aria-controls="Acc-{{ block.id }}">
                <span>{{ block.settings.heading }}</span>
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__body" id="Acc-{{ block.id }}">
                <div><div class="accordion__inner rte">{{ mf | metafield_tag }}</div></div>
              </div>
            </div>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="product__block rte text-muted" style="font-size: 1.3rem;" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'sku' -%}
          {%- if current_variant.sku != blank -%}
            <p class="product__tax-note" {{ block.shopify_attributes }}>{{ 'products.product.sku' | t }}: {{ current_variant.sku }}</p>
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{%- comment -%} ---------- Data for JS ---------- {%- endcomment -%}
<script type="application/json" data-variants-json>
[
  {%- for v in product.variants -%}
    {
      "id": {{ v.id }},
      "options": {{ v.options | json }},
      "price": {{ v.price }},
      "compare_at_price": {{ v.compare_at_price | default: 0 }},
      "available": {{ v.available }},
      "featured_media_id": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
</script>

{%- comment -%} ---------- Sticky mobile add to cart ---------- {%- endcomment -%}
{%- if section.settings.sticky_atc -%}
  <div class="sticky-atc" data-sticky-atc>
    <div class="sticky-atc__info">
      <p class="sticky-atc__title">{{ product.title }}</p>
      <p class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</p>
    </div>
    <button type="button" class="btn btn--primary" data-sticky-add>
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
{%- endif -%}

{%- comment -%} ---------- Size guide modal ---------- {%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'variant_picker' and block.settings.size_guide_page != blank -%}
    <div class="modal" id="SizeGuide" role="dialog" aria-modal="true" aria-label="{{ 'products.product.size_guide' | t }}" aria-hidden="true">
      <div class="modal__backdrop" data-close></div>
      <div class="modal__panel">
        <button type="button" class="modal__close" data-close aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', icon: 'close' %}
        </button>
        <h2 class="h2">{{ block.settings.size_guide_page.title }}</h2>
        <div class="rte">{{ block.settings.size_guide_page.content }}</div>
      </div>
    </div>
  {%- endif -%}
{%- endfor -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product",
  "class": "shopify-section--product",
  "settings": [
    { "type": "select", "id": "desktop_layout", "label": "Desktop image layout", "default": "stack", "options": [
      { "value": "stack", "label": "Single column stack" },
      { "value": "grid", "label": "Two column grid" }
    ]},
    { "type": "checkbox", "id": "sticky_atc", "label": "Sticky add to cart on mobile", "default": true }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1, "settings": [] },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [
      { "type": "text", "id": "tax_note", "label": "Note under price", "default": "Tax included. Shipping calculated at checkout." }
    ]},
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [
      { "type": "page", "id": "size_guide_page", "label": "Size guide page", "info": "Shown in a modal from the \"Size guide\" link." }
    ]},
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": false },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true },
      { "type": "checkbox", "id": "show_stock", "label": "Show low stock warning", "default": true },
      { "type": "range", "id": "low_stock_threshold", "min": 1, "max": 20, "step": 1, "label": "Low stock threshold", "default": 5 }
    ]},
    { "type": "trust", "name": "Trust icons", "limit": 1, "settings": [
      { "type": "text", "id": "item_1", "label": "Item 1", "default": "Ships in 48h" },
      { "type": "text", "id": "item_2", "label": "Item 2", "default": "14-day returns" },
      { "type": "text", "id": "item_3", "label": "Item 3", "default": "Secure checkout" }
    ]},
    { "type": "description", "name": "Description", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Description" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": true }
    ]},
    { "type": "accordion", "name": "Accordion row", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "page", "id": "page", "label": "Or pull content from a page" }
    ]},
    { "type": "metafield_accordion", "name": "Accordion from metafield", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Fit & materials" },
      { "type": "text", "id": "metafield_key", "label": "Metafield key", "default": "fit", "info": "Namespace \"custom\", e.g. custom.fit" }
    ]},
    { "type": "text", "name": "Text", "settings": [
      { "type": "richtext", "id": "text", "label": "Text" }
    ]},
    { "type": "sku", "name": "SKU", "limit": 1, "settings": [] }
  ]
}
{% endschema %}
