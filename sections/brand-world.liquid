<div class="section section--flush">
  <div class="split{% if section.settings.reverse %} split--reverse{% endif %}" data-reveal>
    <div class="split__media" style="aspect-ratio: {{ section.settings.ratio }};">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}"
             srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1000 }} 1000w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
             sizes="(min-width: 750px) 50vw, 100vw"
             alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
             width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="split__content" style="background: {{ section.settings.bg }}; color: {{ section.settings.text_color }};">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ui-label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte" style="max-width: 44ch; font-size: 1.45rem;">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <div>
          <a class="btn btn--outline btn--lg" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand story",
  "class": "shopify-section--brand",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE WORLD OF SAUDADE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Longing, worn well." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Saudade is the ache for something you can't name — and the outfit you wear while you chase it. Made in small runs, for the girls who leave a trace.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "OUR STORY" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "select", "id": "ratio", "label": "Image ratio", "default": "4/5", "options": [
      { "value": "4/5", "label": "Portrait 4:5" },
      { "value": "1/1", "label": "Square" },
      { "value": "3/4", "label": "Tall 3:4" }
    ]},
    { "type": "color", "id": "bg", "label": "Panel background", "default": "#F1EBE6" },
    { "type": "color", "id": "text_color", "label": "Panel text", "default": "#141110" }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
