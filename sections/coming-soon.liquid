{%- comment -%}
  "Coming soon" preview grid, shown under the early-access campaign.

  Each card is a block. It can point at a Shopify product (used once the
  product is active on the Online Store), or be filled by hand with an image,
  a name and a price — so the drop can be previewed while the products are
  still drafts. Nothing here can be added to the cart: every card leads to the
  early-access email form.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<div class="section cs" id="ComingSoon">
  <div class="page-width">
    <div class="cs__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="cs__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cs__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="product-grid cs__grid" style="--cols: {{ section.blocks.size | at_most: section.settings.columns }}; --cols-tablet: {{ section.blocks.size | at_most: 3 }}; --cols-mobile: 2;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign title = block.settings.title
          assign img_1 = block.settings.image
          assign img_2 = block.settings.image_hover
          assign price_text = block.settings.price
          if p != blank
            if title == blank
              assign title = p.title
            endif
            if img_1 == blank
              assign img_1 = p.featured_media.preview_image
            endif
            if img_2 == blank and p.media.size > 1
              assign img_2 = p.media[1].preview_image
            endif
            if price_text == blank
              assign price_text = p.price | money
            endif
          endif
        -%}
        <div class="card cs-card" data-reveal data-reveal-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <div class="card__media-wrap">
            <a class="card__media" href="#EarlyAccessForm" data-ea-notify aria-label="{{ title | escape }} — {{ section.settings.button_label | escape }}">
              {%- if img_1 != blank -%}
                <img class="card__img card__img--main{% if img_2 == blank %} card__img--only{% endif %}"
                     src="{{ img_1 | image_url: width: 800 }}"
                     srcset="{{ img_1 | image_url: width: 400 }} 400w, {{ img_1 | image_url: width: 600 }} 600w, {{ img_1 | image_url: width: 800 }} 800w, {{ img_1 | image_url: width: 1100 }} 1100w"
                     sizes="(min-width: 990px) 25vw, 50vw"
                     alt="{{ img_1.alt | default: title | escape }}"
                     width="{{ img_1.width }}" height="{{ img_1.height }}" loading="lazy">
                {%- if img_2 != blank -%}
                  <img class="card__img card__img--hover"
                       src="{{ img_2 | image_url: width: 800 }}"
                       srcset="{{ img_2 | image_url: width: 400 }} 400w, {{ img_2 | image_url: width: 800 }} 800w"
                       sizes="(min-width: 990px) 25vw, 50vw"
                       alt="" width="{{ img_2.width }}" height="{{ img_2.height }}" loading="lazy">
                {%- endif -%}
              {%- else -%}
                <div class="waffle-fallback" aria-hidden="true"></div>
              {%- endif -%}

              {%- if section.settings.badge != blank -%}
                <div class="card__badges"><span class="badge cs-card__badge">{{ section.settings.badge }}</span></div>
              {%- endif -%}
            </a>
          </div>

          <div class="card__info">
            <h3 class="card__title">{{ title }}</h3>
            {%- if section.settings.show_price and price_text != blank -%}
              <div class="card__price">{{ price_text }}</div>
            {%- endif -%}
            {%- if block.settings.stock_note != blank -%}
              <p class="cs-card__stock">
                <span class="cs-card__dot" aria-hidden="true"></span>{{ block.settings.stock_note }}
              </p>
              {%- if block.settings.stock_percent > 0 -%}
                <div class="cs-card__bar" role="img" aria-label="{{ block.settings.stock_note | escape }}">
                  <span style="width: {{ block.settings.stock_percent }}%;"></span>
                </div>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.button_label != blank -%}
              <a class="cs-card__notify" href="#EarlyAccessForm" data-ea-notify>{{ section.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Coming soon products",
  "class": "shopify-section--coming-soon",
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "Shown under the early-access campaign. Cards can't be bought — they send visitors to the email form." },
    { "type": "text", "id": "eyebrow", "label": "Small line above the title", "default": "COMING SOON" },
    { "type": "text", "id": "heading", "label": "Title", "default": "THE WAFFLE SET" },
    { "type": "text", "id": "badge", "label": "Badge on the images", "default": "COMING SOON" },
    { "type": "checkbox", "id": "show_price", "label": "Show prices", "default": true },
    { "type": "text", "id": "button_label", "label": "Link under each card", "default": "GET EARLY ACCESS" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns (desktop)", "default": 2 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Piece",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_hover", "label": "Second image (on hover)" },
        { "type": "text", "id": "title", "label": "Name" },
        { "type": "text", "id": "price", "label": "Price", "info": "e.g. €159" },
        { "type": "text", "id": "stock_note", "label": "Stock line", "info": "Optional, e.g. LIMITED STOCK or 50 PIECES ONLY." },
        { "type": "range", "id": "stock_percent", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Stock bar", "default": 0, "info": "0 = no bar." },
        { "type": "product", "id": "product", "label": "Or link a Shopify product", "info": "Only used once the product is active on the Online Store. Fills any empty field above." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "title": "The Waffle Hoodie — Camo", "price": "€89", "product": "the-waffle-hoodie-camo" } },
      { "type": "item", "settings": { "title": "The Waffle Pants — Camo", "price": "€89", "product": "the-waffle-pants-camo" } }
    ]
  }
}
{% endschema %}
