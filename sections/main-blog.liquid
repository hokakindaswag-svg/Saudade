<div class="page-width section">
  <h1 class="h1" style="margin-bottom: 28px;">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="product-grid" style="--cols: 3; --cols-tablet: 2; --cols-mobile: 1;">
      {%- for article in blog.articles -%}
        <a class="article-card" href="{{ article.url }}" data-reveal>
          <div class="article-card__media">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.title | escape }}" loading="lazy" width="900" height="600">
            {%- endif -%}
          </div>
          <h2 class="article-card__title">{{ article.title }}</h2>
          <p class="text-muted" style="font-size: 1.15rem;">{{ article.published_at | date: '%B %d, %Y' }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
