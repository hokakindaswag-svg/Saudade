<footer class="footer" role="contentinfo">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand" data-reveal>
        {%- if section.settings.show_logo -%}
          <div class="footer__logo">
            {%- if settings.logo != blank -%}
              <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}"
                   width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" loading="lazy">
            {%- else -%}
              <span class="header__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="text-muted" style="max-width: 34ch;">{{ section.settings.tagline }}</p>
        {%- endif -%}
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', icon: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', icon: 'pinterest' %}</a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', icon: 'youtube' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div data-reveal {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.heading }}</p>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div data-reveal {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.heading }}</p>
              <div class="rte text-muted" style="font-size: 1.25rem;">{{ block.settings.text }}</div>
            </div>
          {%- when 'newsletter' -%}
            <div data-reveal {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.heading }}</p>
              {%- if block.settings.text != blank -%}
                <p class="text-muted" style="font-size: 1.25rem; margin-bottom: 12px;">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'newsletter__form', style: 'margin: 0; max-width: none;' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="hidden" name="contact[accepts_marketing]" value="true">
                <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter_form.email_placeholder' | t }}</label>
                <input class="input" id="FooterEmail" type="email" name="contact[email]" required
                       placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" autocomplete="email">
                <button type="submit" class="btn btn--primary">{{ 'general.newsletter_form.submit' | t }}</button>
                {%- if form.errors -%}
                  <p class="form-status form-status--error">{{ form.errors.messages['email'] }}</p>
                {%- elsif form.posted_successfully? -%}
                  <p class="form-status form-status--success">{{ 'general.newsletter_form.success' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>
        {%- if section.settings.show_localization and localization.available_countries.size > 1 -%}
          {%- form 'localization', id: 'FooterCountryForm' -%}
            <label class="visually-hidden" for="FooterCountry">Country</label>
            <select class="input" id="FooterCountry" name="country_code" onchange="this.form.submit()" style="min-height: 34px; padding: 4px 26px 4px 8px; font-size: 1.1rem;">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }})
                </option>
              {%- endfor -%}
            </select>
          {%- endform -%}
        {%- endif -%}
      </span>
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": true },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Made for the girls who leave a trace." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Show country / currency selector", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>hello@saudade.com</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Get in early" },
        { "type": "text", "id": "text", "label": "Text", "default": "First access to drops, restocks & everything Saudade." }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
