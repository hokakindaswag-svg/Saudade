{%- comment -%}
  Early-access landing page (pre-launch preview).

  Rendered by layout/theme.liquid in place of the homepage while
  Theme settings → Early access → "Enable Early Access Landing Page" is on.

  Layout, top to bottom:
    1. Campaign image / video, full screen, under the transparent header.
    2. The drop's pieces ("Piece" blocks): photo carousel, name, a
       "sign up to be notified" button and the price. Nothing is purchasable;
       pieces are filled by hand so the products can stay Draft in Admin.
    3. Email sign-up (Shopify's native customer form): every submission
       creates or updates a customer in Admin → Customers, subscribed to email
       marketing and tagged with the tags set below.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign form_id = 'EarlyAccessForm'

  assign media_mode = 'none'
  if s.video != blank
    assign media_mode = 'shopify_video'
  elsif s.video_url != blank
    assign media_mode = 'url_video'
  elsif s.image != blank
    assign media_mode = 'image'
  endif
  assign poster = s.image | default: s.image_mobile

  assign piece_count = section.blocks.size
  assign cols_desktop = piece_count | at_most: 4 | at_least: 1
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ea-overlay: {{ s.overlay | divided_by: 100.0 }};
    --ea-fallback-1: {{ s.fallback_color_1 }};
    --ea-fallback-2: {{ s.fallback_color_2 }};
    --ea-cols: {{ cols_desktop }};
  }
  {%- if s.image != blank -%}
    #shopify-section-{{ section.id }} .ea__img--desktop { object-position: {{ s.image.presentation.focal_point }}; }
  {%- endif -%}
  {%- if s.image_mobile != blank -%}
    #shopify-section-{{ section.id }} .ea__img--mobile { object-position: {{ s.image_mobile.presentation.focal_point }}; }
  {%- endif -%}
</style>

{%- comment -%} ---------- 1. Campaign ---------- {%- endcomment -%}
<section class="ea ea--text-{{ s.text_color_scheme }}{% if media_mode == 'none' %} ea--no-media{% endif %}{% if s.show_text_on_image %} ea--with-text{% endif %}"
         {% unless s.show_announcement %}data-hide-announcement{% endunless %}
         aria-label="{{ s.heading | escape }}">
  <div class="ea__media">
    {%- case media_mode -%}
      {%- when 'shopify_video' -%}
        {{ s.video | video_tag: image_size: '1400x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'ea__video' }}

      {%- when 'url_video' -%}
        <video class="ea__video" autoplay muted loop playsinline preload="metadata"
               {% if poster != blank %}poster="{{ poster | image_url: width: 1400 }}"{% endif %}
               aria-label="{{ s.heading | escape }}">
          <source src="{{ s.video_url }}" type="video/mp4">
        </video>

      {%- when 'image' -%}
        <img class="ea__img ea__img--desktop{% if s.image_mobile != blank %} ea__img--has-mobile{% endif %}"
             src="{{ s.image | image_url: width: 2000 }}"
             srcset="{{ s.image | image_url: width: 750 }} 750w,
                     {{ s.image | image_url: width: 1100 }} 1100w,
                     {{ s.image | image_url: width: 1500 }} 1500w,
                     {{ s.image | image_url: width: 2000 }} 2000w,
                     {{ s.image | image_url: width: 2800 }} 2800w"
             sizes="100vw"
             alt="{{ s.image.alt | default: s.heading | escape }}"
             width="{{ s.image.width }}" height="{{ s.image.height }}"
             fetchpriority="high">
        {%- if s.image_mobile != blank -%}
          <img class="ea__img ea__img--mobile"
               src="{{ s.image_mobile | image_url: width: 1000 }}"
               srcset="{{ s.image_mobile | image_url: width: 500 }} 500w,
                       {{ s.image_mobile | image_url: width: 750 }} 750w,
                       {{ s.image_mobile | image_url: width: 1000 }} 1000w,
                       {{ s.image_mobile | image_url: width: 1300 }} 1300w"
               sizes="100vw"
               alt="{{ s.image_mobile.alt | default: s.heading | escape }}"
               width="{{ s.image_mobile.width }}" height="{{ s.image_mobile.height }}"
               fetchpriority="high">
        {%- endif -%}

      {%- else -%}
        {%- comment -%} No campaign media yet: a waffle-knit texture in the brand colours. {%- endcomment -%}
        <div class="ea__fallback" aria-hidden="true"></div>
    {%- endcase -%}
    <div class="ea__overlay" aria-hidden="true"></div>
  </div>

  {%- if s.show_text_on_image -%}
    <div class="ea__panel">
      <div class="ea__content">
        <h1 class="ea__title">{{ s.heading }}</h1>
        {%- if s.subheading != blank -%}<p class="ea__sub">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.hero_button_label != blank -%}
          <a class="ea__btn" href="#{{ form_id }}" data-ea-notify>{{ s.hero_button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <h1 class="visually-hidden">{{ s.heading }}</h1>
  {%- endif -%}
</section>

{%- comment -%} ---------- 2. The pieces ---------- {%- endcomment -%}
{%- if piece_count > 0 -%}
  <div class="ea-shop page-width" id="EarlyAccessPieces">
    <div class="ea-shop__bar">
      <p class="ea-shop__count">{{ 'sections.early_access.items' | t: count: piece_count }}</p>
      {%- if piece_count > 1 -%}
        <div class="ea-shop__views" role="group" aria-label="{{ 'sections.early_access.view' | t }}">
          <button type="button" class="ea-view" data-ea-view="large" aria-pressed="false" aria-label="{{ 'sections.early_access.view_large' | t }}">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="1.5" y="1.5" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
          </button>
          <button type="button" class="ea-view is-active" data-ea-view="grid" aria-pressed="true" aria-label="{{ 'sections.early_access.view_grid' | t }}">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="1.5" y="1.5" width="7" height="17" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="11.5" y="1.5" width="7" height="17" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="ea-grid" data-ea-grid data-view="grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign title = block.settings.title
          assign price_text = block.settings.price
          assign manual_images = ''
          if block.settings.image_1 != blank
            assign manual_images = 'x'
          endif
          if p != blank
            if title == blank
              assign title = p.title
            endif
            if price_text == blank
              assign price_text = p.price | money_with_currency
            endif
          endif
          assign slide_count = 0
        -%}
        <div class="ea-card" data-reveal data-reveal-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <div class="ea-card__media" data-ea-slider>
            <div class="ea-card__track" data-ea-track>
              {%- if manual_images != blank -%}
                {%- for i in (1..4) -%}
                  {%- liquid
                    case i
                      when 1
                        assign img = block.settings.image_1
                      when 2
                        assign img = block.settings.image_2
                      when 3
                        assign img = block.settings.image_3
                      when 4
                        assign img = block.settings.image_4
                    endcase
                  -%}
                  {%- if img != blank -%}
                    {%- assign slide_count = slide_count | plus: 1 -%}
                    <div class="ea-card__slide">
                      <img src="{{ img | image_url: width: 900 }}"
                           srcset="{{ img | image_url: width: 450 }} 450w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
                           sizes="(min-width: 990px) {{ 100 | divided_by: cols_desktop }}vw, 50vw"
                           alt="{{ img.alt | default: title | escape }}"
                           width="{{ img.width }}" height="{{ img.height }}"
                           loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif p != blank and p.media.size > 0 -%}
                {%- for media in p.media limit: 8 -%}
                  {%- assign slide_count = slide_count | plus: 1 -%}
                  <div class="ea-card__slide">
                    <img src="{{ media.preview_image | image_url: width: 900 }}"
                         srcset="{{ media.preview_image | image_url: width: 450 }} 450w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1200 }} 1200w"
                         sizes="(min-width: 990px) {{ 100 | divided_by: cols_desktop }}vw, 50vw"
                         alt="{{ media.alt | default: title | escape }}"
                         width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}"
                         loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="ea-card__slide"><div class="waffle-fallback" aria-hidden="true"></div></div>
              {%- endif -%}
            </div>

            {%- if slide_count > 1 -%}
              <div class="ea-card__dots">
                {%- for i in (1..slide_count) -%}
                  <button type="button" class="ea-card__dot{% if forloop.first %} is-active{% endif %}" data-ea-dot="{{ forloop.index0 }}"
                          aria-label="{{ 'sections.early_access.photo' | t: number: forloop.index, total: slide_count }}"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          <h3 class="ea-card__title">{{ s.title_prefix }}{{ title }}</h3>

          {%- if s.card_button_label != blank -%}
            <a class="ea-card__notify" href="#{{ form_id }}" data-ea-notify>{{ s.card_button_label }}</a>
          {%- endif -%}

          {%- if price_text != blank -%}
            <p class="ea-card__price">{{ price_text }}</p>
          {%- endif -%}

          {%- if block.settings.stock_note != blank -%}
            <p class="ea-card__stock"><span class="ea-card__stock-dot" aria-hidden="true"></span>{{ block.settings.stock_note }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- comment -%} ---------- 3. Email sign-up ---------- {%- endcomment -%}
<div class="ea-signup page-width" id="EarlyAccess">
  <div class="ea-signup__inner">
    {%- if s.signup_heading != blank -%}
      <h2 class="ea-signup__title">{{ s.signup_heading }}</h2>
    {%- endif -%}
    {%- if s.subheading != blank -%}
      <p class="ea-signup__sub">{{ s.subheading }}</p>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'ea-signup__form', novalidate: 'novalidate', data-ea-form: '' -%}
      {%- if form.posted_successfully? -%}
        <div class="ea-signup__success" role="status" tabindex="-1" data-ea-success>
          <p class="ea-signup__success-title">{{ s.success_heading }}</p>
          <p class="ea-signup__success-text">{{ s.success_text }}</p>
        </div>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="{{ s.customer_tags | escape }}">
        <input type="hidden" name="contact[accepts_marketing]" value="true">

        <label class="visually-hidden" for="EarlyAccessEmail-{{ section.id }}">{{ s.email_placeholder }}</label>
        <input class="ea-signup__input"
               id="EarlyAccessEmail-{{ section.id }}"
               type="email"
               name="contact[email]"
               placeholder="{{ s.email_placeholder | escape }}"
               autocomplete="email"
               autocapitalize="off"
               autocorrect="off"
               spellcheck="false"
               inputmode="email"
               enterkeyhint="send"
               required
               aria-required="true"
               aria-describedby="EarlyAccessError-{{ section.id }}"
               {% if form.errors %}aria-invalid="true" value="{{ form.email | escape }}"{% endif %}
               data-ea-input>
        <button type="submit" class="ea-signup__btn" data-ea-submit>
          <span class="btn__text">{{ s.button_label }}</span>
        </button>

        <p class="ea-signup__error" id="EarlyAccessError-{{ section.id }}" role="alert" data-ea-error
           data-msg-required="{{ 'sections.early_access.email_required' | t | escape }}"
           data-msg-invalid="{{ 'sections.early_access.email_invalid' | t | escape }}"
           {% unless form.errors %}hidden{% endunless %}>
          {%- if form.errors -%}
            {%- for field in form.errors -%}
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </p>

        {%- if s.disclaimer != blank -%}
          <p class="ea-signup__disclaimer">{{ s.disclaimer }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Early access landing",
  "class": "shopify-section--early-access",
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown instead of the homepage while Theme settings → Early access → \"Enable Early Access Landing Page\" is on. Campaign image → the pieces → email sign-up."
    },
    { "type": "header", "content": "Campaign image" },
    { "type": "image_picker", "id": "image", "label": "Campaign image (desktop)", "info": "Set the focal point on the image so it crops well on every screen." },
    { "type": "image_picker", "id": "image_mobile", "label": "Campaign image (mobile)", "info": "Optional. A vertical 9:16 shot works best for TikTok / Instagram traffic." },
    { "type": "video", "id": "video", "label": "Campaign video", "info": "Optional. Overrides the images. Plays muted and looped." },
    { "type": "text", "id": "video_url", "label": "Or a video URL (.mp4)", "info": "Optional. Used when no video is picked above." },
    { "type": "range", "id": "overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Darkening behind the header", "default": 20 },
    { "type": "select", "id": "text_color_scheme", "label": "Header colour over the image", "default": "light", "options": [
      { "value": "light", "label": "White" },
      { "value": "dark", "label": "Dark" }
    ]},
    { "type": "color", "id": "fallback_color_1", "label": "Background colour 1 (no image)", "default": "#F7B5C9" },
    { "type": "color", "id": "fallback_color_2", "label": "Background colour 2 (no image)", "default": "#C9B6FF" },
    { "type": "checkbox", "id": "show_text_on_image", "label": "Show the title on the image", "default": false, "info": "Off: the image stays clean and the title sits above the email form." },
    { "type": "text", "id": "hero_button_label", "label": "Button on the image", "default": "GET EARLY ACCESS", "info": "Only when the title is shown on the image. Scrolls to the email form." },
    { "type": "checkbox", "id": "show_announcement", "label": "Show the announcement bar", "default": true },

    { "type": "header", "content": "The pieces" },
    { "type": "text", "id": "title_prefix", "label": "Before each name", "default": "COMING SOON - " },
    { "type": "text", "id": "card_button_label", "label": "Button under each piece", "default": "SIGN UP TO BE NOTIFIED", "info": "Scrolls to the email form." },

    { "type": "header", "content": "Email sign-up" },
    { "type": "text", "id": "heading", "label": "Drop name", "default": "THE WAFFLE SET" },
    { "type": "text", "id": "signup_heading", "label": "Sign-up title", "default": "THE WAFFLE SET" },
    { "type": "text", "id": "subheading", "label": "Sign-up text", "default": "Shoppez le prochain drop en early access." },
    { "type": "text", "id": "email_placeholder", "label": "Email field placeholder", "default": "Votre adresse email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "GET EARLY ACCESS" },
    { "type": "text", "id": "customer_tags", "label": "Customer tags", "default": "early-access, waffle-set", "info": "Added to every sign-up in Admin → Customers, so you can count and email the early-access list." },
    { "type": "text", "id": "disclaimer", "label": "Small print under the form" },
    { "type": "text", "id": "success_heading", "label": "Success title", "default": "YOU'RE IN." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Tu seras parmi les premières à pouvoir shopper THE WAFFLE SET." }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Piece",
      "settings": [
        { "type": "text", "id": "title", "label": "Name" },
        { "type": "text", "id": "price", "label": "Price", "info": "e.g. €89 EUR" },
        { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
        { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
        { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
        { "type": "image_picker", "id": "image_4", "label": "Photo 4" },
        { "type": "text", "id": "stock_note", "label": "Stock line", "info": "Optional, e.g. LIMITED STOCK." },
        { "type": "product", "id": "product", "label": "Linked product", "info": "Used once the product is active on the Online Store: fills the name, price and photos left empty above." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "piece", "settings": { "title": "The Waffle Hoodie — Camo", "price": "€89 EUR", "product": "the-waffle-hoodie-camo" } },
      { "type": "piece", "settings": { "title": "The Waffle Pants — Camo", "price": "€89 EUR", "product": "the-waffle-pants-camo" } }
    ]
  }
}
{% endschema %}
