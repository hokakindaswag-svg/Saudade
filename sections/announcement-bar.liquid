{%- if section.blocks.size > 0 -%}
  <div class="announcement" data-announcement data-speed="{{ section.settings.speed }}"
       style="background: {{ section.settings.bg }}; color: {{ section.settings.text_color }};">
    <div class="announcement__viewport">
      <div class="announcement__track{% if section.blocks.size == 1 %} announcement__track--single{% endif %}">
        {%- for block in section.blocks -%}
          <div class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section--announcement",
  "max_blocks": 5,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FF2E88" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "range", "id": "speed", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Seconds per message", "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "NEW DROP — SHOP NOW" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "NEW DROP — SHOP NOW" } },
        { "type": "message", "settings": { "text": "FREE SHIPPING OVER €150" } },
        { "type": "message", "settings": { "text": "EASY 14-DAY RETURNS" } }
      ]
    }
  ]
}
{% endschema %}
