<div class="page-width section">
  <h1 class="h1" style="margin-bottom: 26px;">{{ page_title }}</h1>
  <div class="collection-tiles" style="--tiles: 4; gap: var(--grid-gap);">
    {%- for collection in collections -%}
      <a class="collection-tile" href="{{ collection.url }}" data-reveal>
        <div class="collection-tile__media">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 800 }}"
                 srcset="{{ collection.featured_image | image_url: width: 400 }} 400w, {{ collection.featured_image | image_url: width: 800 }} 800w"
                 sizes="(min-width: 750px) 25vw, 50vw" alt="{{ collection.title | escape }}" loading="lazy" width="600" height="750">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <span class="collection-tile__label">
          <span>{{ collection.title }}</span>
          {% render 'icon', icon: 'arrow-right' %}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
