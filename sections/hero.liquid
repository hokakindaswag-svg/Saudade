{%- liquid
  comment
    Media priority: a video picked from Shopify Files, then an external video
    URL, then the video bundled with the theme, then the image.
  endcomment
  assign video_mode = ''
  if section.settings.video != blank
    assign video_mode = 'shopify'
  elsif section.settings.video_url != blank
    assign video_mode = 'url'
  elsif section.settings.use_bundled_video
    assign video_mode = 'asset'
  endif

  assign poster_url = ''
  if section.settings.image != blank
    assign poster_url = section.settings.image | image_url: width: 1200
  else
    assign poster_url = 'hero-poster.jpg' | asset_url
  endif
-%}

<div class="hero hero--h-{{ section.settings.height }} hero--{{ section.settings.text_color_scheme }}{% if section.settings.mobile_tall %} hero--mobile-tall{% endif %}">
  <div class="hero__media">
    {%- if video_mode == 'shopify' -%}
      {{ section.settings.video | video_tag: image_size: '1100x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}

    {%- elsif video_mode == 'url' or video_mode == 'asset' -%}
      {%- liquid
        if video_mode == 'url'
          assign video_src = section.settings.video_url
        else
          assign video_src = 'hero-video.mp4' | asset_url
        endif
      -%}
      {%- if section.settings.desktop_video_fit == 'contain' -%}
        <div class="hero__video-backdrop" style="background-image: url({{ poster_url }});" aria-hidden="true"></div>
      {%- endif -%}
      <video
        class="hero__video hero__video--{{ section.settings.desktop_video_fit }}"
        autoplay muted loop playsinline
        preload="metadata"
        poster="{{ poster_url }}"
        aria-label="{{ section.settings.heading | escape }}">
        <source src="{{ video_src }}" type="video/mp4">
      </video>

    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 1100 }} 1100w,
                {{ section.settings.image | image_url: width: 1500 }} 1500w,
                {{ section.settings.image | image_url: width: 2000 }} 2000w,
                {{ section.settings.image | image_url: width: 2800 }} 2800w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
        fetchpriority="high">
      {%- if section.settings.image_mobile != blank -%}
        <style>
          #shopify-section-{{ section.id }} .hero__media > img { object-position: {{ section.settings.focal }}; }
          @media screen and (max-width: 749px) {
            #shopify-section-{{ section.id }} .hero__media > img:first-of-type { display: none; }
            #shopify-section-{{ section.id }} .hero__media > img.hero__img-mobile { display: block; }
          }
          @media screen and (min-width: 750px) {
            #shopify-section-{{ section.id }} .hero__media > img.hero__img-mobile { display: none; }
          }
        </style>
        <img class="hero__img-mobile"
          src="{{ section.settings.image_mobile | image_url: width: 900 }}"
          srcset="{{ section.settings.image_mobile | image_url: width: 600 }} 600w, {{ section.settings.image_mobile | image_url: width: 900 }} 900w, {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w"
          sizes="100vw"
          alt="{{ section.settings.image_mobile.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}"
          fetchpriority="high">
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    <div class="hero__overlay" style="--o-top: {{ section.settings.overlay_top | divided_by: 100.0 }}; --o-bottom: {{ section.settings.overlay_bottom | divided_by: 100.0 }};"></div>

    <div class="hero__content hero__content--{{ section.settings.position }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <p class="hero__title h-display" data-reveal data-reveal-delay="1">{{ section.settings.heading }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero__text" data-reveal data-reveal-delay="2">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank or section.settings.cta_2_text != blank -%}
        <div class="hero__ctas" data-reveal data-reveal-delay="3">
          {%- if section.settings.cta_text != blank -%}
            <a class="btn btn--lg {% if section.settings.text_color_scheme == 'light' %}btn--light{% else %}btn--primary{% endif %}" href="{{ section.settings.cta_link }}">
              {{ section.settings.cta_text }}
            </a>
          {%- endif -%}
          {%- if section.settings.cta_2_text != blank -%}
            <a class="btn btn--lg {% if section.settings.text_color_scheme == 'light' %}btn--ghost-light{% else %}btn--outline{% endif %}" href="{{ section.settings.cta_2_link }}">
              {{ section.settings.cta_2_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_scroll_hint -%}
      <span class="hero__scroll">Scroll</span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "class": "shopify-section--hero",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Optional. A portrait crop performs best on TikTok/IG traffic." },
    { "type": "video", "id": "video", "label": "Video", "info": "Pick a video you uploaded to Shopify (Content > Files). Overrides everything below. Autoplays muted and looped." },
    { "type": "checkbox", "id": "use_bundled_video", "label": "Use the video bundled with the theme", "default": false, "info": "Plays assets/hero-video.mp4. Turn off to use an image instead." },
    { "type": "text", "id": "video_url", "label": "Or paste a video URL", "info": "A direct link to an .mp4 file, e.g. from Shopify Files. Overrides the bundled video." },
    { "type": "select", "id": "desktop_video_fit", "label": "Video fit on desktop", "default": "cover", "options": [
      { "value": "cover", "label": "Fill the screen (crops the sides)" },
      { "value": "contain", "label": "Show the whole frame (best for vertical video)" }
    ], "info": "Vertical phone video gets heavily cropped when it fills a wide screen. \"Show the whole frame\" keeps the full shot and blurs the background behind it. Mobile always fills the screen." },
    { "type": "select", "id": "focal", "label": "Image focal point", "default": "center", "options": [
      { "value": "center", "label": "Centre" },
      { "value": "top", "label": "Top" },
      { "value": "bottom", "label": "Bottom" },
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ]},
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW DROP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Saudade 01" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "cta_2_text", "label": "Second button label" },
    { "type": "url", "id": "cta_2_link", "label": "Second button link" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" },
      { "value": "full", "label": "Full screen" }
    ]},
    { "type": "checkbox", "id": "mobile_tall", "label": "Full screen on mobile", "default": true },
    { "type": "select", "id": "position", "label": "Content position", "default": "bottom-left", "options": [
      { "value": "bottom-left", "label": "Bottom left" },
      { "value": "bottom-center", "label": "Bottom centre" },
      { "value": "center", "label": "Centre" },
      { "value": "middle-left", "label": "Middle left" }
    ]},
    { "type": "select", "id": "text_color_scheme", "label": "Text colour", "default": "light", "options": [
      { "value": "light", "label": "White" },
      { "value": "dark", "label": "Dark" }
    ]},
    { "type": "range", "id": "overlay_top", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Top overlay", "default": 15 },
    { "type": "range", "id": "overlay_bottom", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Bottom overlay", "default": 35 },
    { "type": "checkbox", "id": "show_scroll_hint", "label": "Show scroll hint", "default": false }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
