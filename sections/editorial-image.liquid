<div class="section section--flush">
  <div class="editorial editorial--h-{{ section.settings.height }} editorial--{{ section.settings.text_color_scheme }}" data-reveal>
    <div class="editorial__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1100x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {%- elsif section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 2000 }}"
             srcset="{{ section.settings.image | image_url: width: 750 }} 750w, {{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1500 }} 1500w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
             sizes="100vw" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
             width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      <div class="editorial__overlay" style="--o: {{ section.settings.overlay | divided_by: 100.0 }};"></div>
      <div class="editorial__content editorial__content--{{ section.settings.position }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ui-label">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="editorial__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <a class="btn btn--lg {% if section.settings.text_color_scheme == 'light' %}btn--light{% else %}btn--primary{% endif %}" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial image",
  "class": "shopify-section--editorial",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video (overrides image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The campaign" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "DISCOVER" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "select", "id": "height", "label": "Height", "default": "medium", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" }
    ]},
    { "type": "select", "id": "position", "label": "Content position", "default": "bottom-left", "options": [
      { "value": "center", "label": "Centre" },
      { "value": "bottom-left", "label": "Bottom left" },
      { "value": "bottom-right", "label": "Bottom right" },
      { "value": "middle-left", "label": "Middle left" }
    ]},
    { "type": "select", "id": "text_color_scheme", "label": "Text colour", "default": "light", "options": [
      { "value": "light", "label": "White" },
      { "value": "dark", "label": "Dark" }
    ]},
    { "type": "range", "id": "overlay", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Overlay", "default": 20 }
  ],
  "presets": [{ "name": "Editorial image" }]
}
{% endschema %}
