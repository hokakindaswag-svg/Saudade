<div class="section{% if section.settings.tight %} section--tight{% endif %}">
  <div class="page-width">
    <div class="section-head" data-reveal>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    </div>

    {%- liquid
      assign intent = section.settings.intent
      assign limit = section.settings.count
    -%}
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="{% if section.settings.layout == 'scroll' %}scroller{% else %}product-grid{% endif %}"
           style="--cols: {{ section.settings.columns }}; --cols-tablet: 3; --cols-mobile: 2; --item-w: 62%;">
        {%- for product in recommendations.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div data-recs-placeholder
           data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ intent }}">
      </div>
      <script>
        (function () {
          var el = document.currentScript.previousElementSibling;
          if (!el || !el.dataset.url) return;
          fetch(el.dataset.url)
            .then(function (r) { return r.text(); })
            .then(function (html) {
              var doc = new DOMParser().parseFromString(html, 'text/html');
              var sec = doc.querySelector('.shopify-section--recommendations') || doc.querySelector('.section');
              var host = el.closest('.shopify-section') || el.parentElement;
              if (sec && host) { host.innerHTML = sec.innerHTML; document.dispatchEvent(new CustomEvent('recs:loaded')); }
            })
            .catch(function () {});
        })();
      </script>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "class": "shopify-section--recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "YOU MAY ALSO LIKE" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related", "options": [
      { "value": "related", "label": "Related products" },
      { "value": "complementary", "label": "Complete the look (complementary)" }
    ]},
    { "type": "range", "id": "count", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [
      { "value": "grid", "label": "Grid" },
      { "value": "scroll", "label": "Horizontal scroll" }
    ]},
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "checkbox", "id": "tight", "label": "Reduce vertical spacing", "default": false }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
